{
  "name": "alanjust-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "import": "node scripts/import-portfolio.js",
    "deploy": "rm -f .astro/data-store.json && astro build && wrangler deploy && wrangler deploy -c demos/wrangler.jsonc",
    "preview:worker": "astro build && wrangler dev",
    "cf-types": "wrangler types",
    "preview:demos": "wrangler dev -c demos/wrangler.jsonc --port 8788",
    "build:drafts": "PLAYGROUND_DRAFTS=1 PUBLIC_DEMOS_ORIGIN=http://localhost:8788 astro build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.0.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "sharp": "^0.33.0",
    "wrangler": "^4.151.2"
  }
}
