---
import { navGroups, isCurrent, groupIsCurrent } from '../lib/nav';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<div class="side-menu">
  <nav class="navbar" aria-label="Main">
    <div class="navbar-side">
      {navGroups.map((group, g) => {
        const links = group.links.map((link, i) => (
            <div class="div-side-menu">
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                aria-current={isCurrent(link.href, currentPath) ? 'page' : undefined}
                class={`side-menu-text-link${isCurrent(link.href, currentPath) ? ' w--current' : ''}`}
              >
                {link.label}
              </a>
              <div class={`divider-2-px${g === 0 && i === 0 ? ' _4px-space' : ' with-space'}`}></div>
            </div>
          ));
        const groupClass = `side-menu-group${g > 0 ? ' spaced' : ''}`;
        return group.collapsible ? (
          <details class={`${groupClass} side-menu-collapsible`} open={groupIsCurrent(group, currentPath)}>
            <summary class="side-menu-group-label">{group.heading}</summary>
            {links}
          </details>
        ) : (
          <div class={groupClass}>
            {group.heading && <p class="side-menu-group-label">{group.heading}</p>}
            {links}
          </div>
        );
      })}
    </div>
  </nav>
</div>
