---
// The homepage: the opening grid, centered, with the menu beside it.
// (The earlier masonry homepage lives in git history, before this change.)
import BaseLayout from '../layouts/BaseLayout.astro';
import SideNav from '../components/SideNav.astro';
import { getCollection } from 'astro:content';
import { openingSquares } from '../lib/opening-grid';
import sharp from 'sharp';
import path from 'node:path';

const all = await getCollection('portfolio', ({ data }) => data.showProject);
const bySlug = new Map(all.map(p => [p.data.projectSlug, p]));

// Everything the grid script needs, one entry per square, in grid order.
const squares = (await Promise.all(openingSquares.map(async sq => {
  const p = bySlug.get(sq.slug);
  if (!p || !p.data.heroImage) return null;
  const { width, height } = await sharp(path.join(process.cwd(), 'public', p.data.heroImage)).metadata();
  return { ...sq, title: p.data.title, cat: p.data.category, cats: [p.data.category, ...p.data.alsoIn], hero: p.data.heroImage, w: width, h: height };
}))).filter(Boolean);

// Same kinds of work, same order, as the live homepage. Fine Art always last.
const categoryOrder = ['Packaging', 'Identity', 'Catalogs & Print', 'Illustration', 'Web & Apps', 'Fine Art'];
const used = new Set(squares.flatMap(s => s!.cats));
const categories = ['All', ...categoryOrder.filter(c => used.has(c))];
const countWords = ['Zero','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen','Twenty'];
const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty'];
const n = squares.length;
const countWord = n <= 20 ? countWords[n] : tens[Math.floor(n / 10)] + (n % 10 ? '-' + countWords[n % 10].toLowerCase() : '');
---

<BaseLayout
  title="Alan Just | Graphic Designer and Illustrator"
  description="Portfolio of Alan Just, graphic designer and illustrator. Forty years of packaging, identity and illustration."
  currentPath="/"
  bodyClass="page-home-grid"
>
  <div class="home-grid-layout">
    <SideNav currentPath="/" categories={categories} showLogo />

    <main class="home-grid-main og">
      <h1 class="og-visually-hidden">Alan Just. Graphic designer and illustrator. Forty years of packaging, identity and illustration.</h1>

      <!-- On phones: the logo and the menu button. The logo fades in once the opening is over. -->
      <div class="og-phone-bar">
        <a href="/" class="og-phone-logo" aria-label="Alan Just, home">
          <img src="/images/alan-just-logotype-white.svg" alt="" width="279" height="37" />
        </a>
        <button class="mobile-hamburger og-phone-menu" type="button" data-nav-toggle aria-label="Open navigation">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <!-- On phones the side menu folds away, so the kinds of work sit above the grid. -->
      <div class="og-filter-mobile" role="group" aria-label="Show one kind of work">
        {categories.map(cat => (
          <button type="button" data-filter={cat} aria-pressed={cat === 'All' ? 'true' : 'false'} class={cat === 'All' ? 'active' : undefined}>{cat}</button>
        ))}
      </div>

      <div class="stage" id="og-stage">
        <div class="intro" id="og-intro" aria-hidden="true">
          <svg class="logo" id="og-logo" viewBox="0 0 278.54 37.41" aria-hidden="true" focusable="false">
        <path d="m26.93,30.51H10.75l-2.28,6.24H0L14.01.54h9.66l13.95,36.21h-8.42l-2.28-6.24Zm-14.12-6.68h12l-5.97-16.61-6.03,16.61Z"/>
        <path d="m40.98.54h7.71v29.43h13.31l-3,6.79h-18.02V.54Z"/>
        <path d="m89.44,30.51h-16.18l-2.28,6.24h-8.47L76.52.54h9.66l13.95,36.21h-8.42l-2.28-6.24Zm-14.12-6.68h12l-5.97-16.61-6.03,16.61Z"/>
        <path d="m111.21,12.43v24.32h-7.71V.54h7.93l16.78,23.45V.54h7.71v36.21h-7.44l-17.26-24.32Z"/>
        <path d="m157.08,27.96c1.41,1.36,3.26,2.61,5.75,2.61,3.42,0,5.65-2.28,5.65-5.81V.54h7.71v24.32c0,8.58-5.32,12.54-12.76,12.54-3.64,0-7.11-.98-9.72-3.53l3.37-5.92Z"/>
        <path d="m183.35.54h7.82v21.5c0,5.05,2.77,8.52,8.42,8.52s8.31-3.47,8.31-8.52V.54h7.82v21.72c0,9.01-5.16,15.15-16.12,15.15s-16.23-6.19-16.23-15.09V.54Z"/>
        <path d="m223.52,25.79c2.55,2.66,6.52,4.89,11.51,4.89,4.23,0,6.3-2.01,6.3-4.07,0-2.71-3.15-3.64-7.33-4.61-5.92-1.36-13.52-2.99-13.52-11.08,0-6.03,5.21-10.91,13.74-10.91,5.75,0,10.53,1.74,14.12,5.05l-4.29,5.65c-2.93-2.71-6.84-3.96-10.37-3.96s-5.32,1.52-5.32,3.69c0,2.44,3.04,3.2,7.22,4.18,5.97,1.36,13.57,3.15,13.57,11.18,0,6.62-4.72,11.62-14.5,11.62-6.95,0-11.94-2.33-15.36-5.75l4.23-5.86Z"/>
        <path d="m260.25,7.33h-10.59V.54h28.88v6.79h-10.53v29.43h-7.76V7.33Z"/>
      </svg>
          <p class="tagline" id="og-tagline">Graphic designer and illustrator. Forty years of packaging, identity and illustration.</p>
        </div>
        <div class="grid is-intro" id="og-grid">
          {squares.map(sq => (
            <a class="tile" href={`/portfolio/${sq!.slug}`} aria-label={`${sq!.title}: show the picture, then open the project`}>
              <div class="card">
                <div class="face front"><img src={`/images/portfolio/opening/tile-${sq!.slug}.webp`} alt={sq!.title} width="420" height="420" /></div>
                <div class="face back"><div class="label"><strong>{sq!.name}</strong><span>{sq!.cat}</span></div></div>
              </div>
              <div class="ink"></div>
            </a>
          ))}
        </div>
        <canvas class="dust" id="og-dust" aria-hidden="true"></canvas>
        <a class="caption" id="og-caption" href="#">
          <strong id="og-caption-title"></strong>
          <span>Read the story →</span>
        </a>
      </div>

      <div class="below">
        <p>{countWord} projects, each boiled down to one square. Click one and the grid turns over to show the whole piece; click again for the story behind it.</p>
        <button type="button" id="og-replay">Play the opening again</button>
      </div>
      <p class="cta-line og-cta">Available for packaging, identity and website projects. <a href="/design-services" class="cta-link">See Design Services →</a></p>
    </main>
  </div>

  <script type="application/json" id="og-data" set:html={JSON.stringify(squares)}></script>
</BaseLayout>

<script>
(() => {
  const SITE = '/portfolio/';
  const ART = '/images/portfolio/opening/';
  const dataEl = document.getElementById('og-data');
  if (!dataEl) return;
  const PROJECTS = JSON.parse(dataEl.textContent || '[]');
  let COLS = 5;              // read from the CSS: 5 across, 4 on phones

  // Timing, in milliseconds.
  const HOLD = 1500;          // how long the logo sits still
  const WIPE = 1800;          // how long the logo takes to crumble, left to right
  const FLY = 850;            // how long a square takes to fly from the logo to its place
  const TEASE_AT_ONCE = 3;    // how many names can be up at the same time
  const TEASE_EVERY = 650;    // gap before the next name turns over, at least...
  const TEASE_EVERY_JITTER = 500; // ...plus up to this much more
  const TEASE_HOLD = 2000;    // how long a name stays up, at least...
  const TEASE_HOLD_JITTER = 600;  // ...plus up to this much more
  const STEP_MS = 55;         // ripple delay per square of distance
  const DROP_STAGGER = 70;    // delay between squares dropping in as you scroll
  const CLOSE_SCROLL = 90;    // scroll this many pixels and an open picture closes


  const stage = document.getElementById('og-stage');
  const grid = document.getElementById('og-grid');
  const intro = document.getElementById('og-intro');
  const logo = document.getElementById('og-logo');
  const tagline = document.getElementById('og-tagline');
  const dust = document.getElementById('og-dust');
  const ctx = dust.getContext('2d');
  const caption = document.getElementById('og-caption');
  const captionTitle = document.getElementById('og-caption-title');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const css = getComputedStyle(document.documentElement);
  const inkColor = () => css.getPropertyValue('--og-ink').trim();

  // ---------- build the tiles ----------
  // The squares are already in the page (so search engines see real links);
  // pair each one with its project data, in order.
  const squareEls = [...grid.querySelectorAll('a.tile')];
  const tiles = PROJECTS.map((p, i) => {
    const el = squareEls[i];
    p.img = p.hero;
    return { el, i, r: 0, c: 0, p,
             back: el.querySelector('.back'), ink: el.querySelector('.ink') };
  });

  // Flat color squares that fill out the last row, so it never ends in a hole.
  const fillers = [2, 3, 1, 4].map((color, k) => {
    const el = document.createElement('div');
    el.className = 'tile is-filler';
    el.setAttribute('aria-hidden', 'true');
    el.innerHTML = `<div class="card">
        <div class="face front tease-${color}"></div>
        <div class="face back"></div>
      </div><div class="ink"></div>`;
    grid.appendChild(el);
    return { el, i: PROJECTS.length + k, r: 0, c: 0, p: null, filler: true,
             back: el.querySelector('.back'), ink: el.querySelector('.ink') };
  });

  let all = tiles;               // every square in the grid, fillers included
  function layout() {
    COLS = Math.max(1, getComputedStyle(grid).gridTemplateColumns.split(' ').length);
    const need = (COLS - PROJECTS.length % COLS) % COLS;
    fillers.forEach((f, k) => { f.el.hidden = k >= need; });
    all = tiles.concat(fillers.filter(f => !f.el.hidden));
    all.forEach((t, i) => { t.r = Math.floor(i / COLS); t.c = i % COLS; });
  }
  layout();

  // Is the middle of this square inside the browser window right now?
  const onScreen = t => {
    const r = t.el.getBoundingClientRect(), mid = r.top + r.height / 2;
    return mid > 0 && mid < innerHeight;
  };

  const box = t => ({ x: t.el.offsetLeft, y: t.el.offsetTop, w: t.el.offsetWidth, h: t.el.offsetHeight });
  // The rectangle covered by a set of squares (whole rows, top to bottom).
  function areaOf(set) {
    const a = box(set[0]), z = box(set[set.length - 1]);
    return { x: a.x, y: a.y, w: z.x + z.w - a.x, h: z.y + z.h - a.y };
  }
  // Paint a face with its share of a picture laid across an area.
  function paint(face, p, area, tile) {
    const s = p.fit === 'cover' ? Math.max(area.w / p.w, area.h / p.h) : Math.min(area.w / p.w, area.h / p.h);
    const bw = p.w * s, bh = p.h * s;
    const x = area.x + (area.w - bw) * p.focus[0];
    const y = area.y + (area.h - bh) * p.focus[1];
    face.style.backgroundImage = `url("${p.img}")`;
    face.style.backgroundSize = `${bw}px ${bh}px`;
    face.style.backgroundPosition = `${x - tile.x}px ${y - tile.y}px`;
  }

  // ---------- state ----------
  let state = 'intro';           // 'intro' | 'idle' | 'revealed'
  let hovering = false;

  // ---------- the opening ----------
  let introRun = 0;              // bumps each time the opening restarts, so stale timers quit
  let particles = [], cells = [], rafId = 0, flyers = [];

  // Squares below the first screen drop in when you scroll down to them.
  const io = new IntersectionObserver(entries => {
    const arriving = entries.filter(e => e.isIntersecting)
      .map(e => all.find(t => t.el === e.target)).filter(Boolean)
      .sort((a, b) => a.r - b.r || a.c - b.c);
    arriving.forEach((t, k) => { io.unobserve(t.el); dropIn(t, k * DROP_STAGGER); });
  }, { threshold: 0.35 });

  function dropIn(t, delay) {
    t.el.classList.remove('is-waiting');
    t.el.classList.add('has-landed');
    if (reduceMotion.matches) return;
    const d = FLY * 0.8;
    t.el.animate([{ transform: 'translateY(-25%) scale(0.15)', opacity: 0 }, { opacity: 1, offset: 0.25 }, { transform: 'none', opacity: 1 }],
                 { duration: d, delay, easing: 'cubic-bezier(0.2, 0.75, 0.25, 1)', fill: 'backwards' });
    t.ink.animate([{ opacity: 1 }, { opacity: 1, offset: 0.15 }, { opacity: 0, offset: 0.55 }, { opacity: 0 }],
                  { duration: d, delay, fill: 'backwards' });
  }

  function sizeDust() {
    const r = stage.getBoundingClientRect(), dpr = devicePixelRatio || 1;
    dust.width = Math.round(r.width * dpr);
    dust.height = Math.round(r.height * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  // Find where the logo has ink: draw it small on a hidden canvas and look at the pixels.
  async function sampleLogo() {
    const s = stage.getBoundingClientRect(), r = logo.getBoundingClientRect();
    const cell = Math.max(4, r.width / 85);
    const w = Math.round(r.width), h = Math.round(r.height);
    const out = [];
    try {
      const clone = logo.cloneNode(true);
      clone.setAttribute('width', w); clone.setAttribute('height', h);
      clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
      clone.querySelectorAll('path').forEach(p => p.setAttribute('fill', '#000'));
      const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(clone)], { type: 'image/svg+xml' }));
      const img = new Image();
      await new Promise((ok, fail) => { img.onload = ok; img.onerror = fail; img.src = url; });
      const c = document.createElement('canvas'); c.width = w; c.height = h;
      const g = c.getContext('2d'); g.drawImage(img, 0, 0, w, h);
      const data = g.getImageData(0, 0, w, h).data;
      URL.revokeObjectURL(url);
      for (let y = cell / 2; y < h; y += cell) for (let x = cell / 2; x < w; x += cell) {
        if (data[(Math.floor(y) * w + Math.floor(x)) * 4 + 3] > 120)
          out.push({ x: r.left - s.left + x, y: r.top - s.top + y, used: false });
      }
    } catch (e) { /* fall back to a loose cloud over the logo's box */ }
    if (!out.length) for (let i = 0; i < 400; i++)
      out.push({ x: r.left - s.left + Math.random() * r.width, y: r.top - s.top + Math.random() * r.height, used: false });
    return { cells: out, cell };
  }

  async function playIntro() {
    const run = ++introRun;
    stopTease();
    hide(true);
    state = 'intro';
    io.disconnect();
    window.scrollTo(0, 0);
    document.body.classList.remove('og-intro-done');
    cancelAnimationFrame(rafId);
    particles = [];
    ctx.clearRect(0, 0, dust.width, dust.height);
    grid.classList.add('is-intro');
    intro.classList.remove('is-gone');
    tagline.classList.remove('is-gone');
    logo.style.clipPath = 'none';
    for (const t of all) { t.el.classList.remove('has-landed', 'is-waiting'); t.el.getAnimations().forEach(a => a.cancel()); t.ink.getAnimations().forEach(a => a.cancel()); }

    // Only the squares on the first screen come out of the logo; the logo sits centered over them.
    flyers = reduceMotion.matches ? all : all.filter(onScreen);
    if (!flyers.length) flyers = all.slice(0, COLS * 2);
    const pad = parseFloat(getComputedStyle(stage).paddingTop) || 0;
    const lastFlyer = box(flyers[flyers.length - 1]);
    intro.style.height = (lastFlyer.y + lastFlyer.h + pad * 2) + 'px';

    sizeDust();
    const sample = await sampleLogo();
    if (run !== introRun) return;
    cells = sample.cells;

    if (reduceMotion.matches) {
      setTimeout(() => { if (run === introRun) { intro.classList.add('is-gone'); flyers.forEach(t => t.el.classList.add('has-landed')); finishIntro(run, 300); } }, 1200);
      return;
    }

    await wait(HOLD);
    if (run !== introRun) return;
    tagline.classList.add('is-gone');

    // Each tile gets a moment in the wipe: left columns go first, with a little shuffle.
    const order = flyers.map(t => ({ t, at: Math.min(0.95, (t.c + Math.random() * 0.9) / COLS) }))
                       .sort((a, b) => a.at - b.at);
    const s = stage.getBoundingClientRect(), L = logo.getBoundingClientRect();
    const logoLeft = L.left - s.left, logoW = L.width;
    const start = performance.now();
    let last = start, next = 0;

    const frame = now => {
      if (run !== introRun) return;
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      const prog = Math.min(1, (now - start) / WIPE);
      const edge = logoLeft + prog * logoW;
      logo.style.clipPath = `inset(0 0 0 ${prog * 100}%)`;

      // The wipe edge sheds ink squares.
      for (const c of cells) if (!c.used && c.x <= edge) {
        c.used = true;
        particles.push({ x: c.x, y: c.y, vx: -(30 + Math.random() * 160), vy: (Math.random() - 0.5) * 120,
                         size: sample.cell * (0.55 + Math.random() * 0.6), age: 0, life: 0.5 + Math.random() * 0.8 });
      }
      // Tiles whose moment has come fly out of the logo.
      while (next < order.length && order[next].at <= prog) launch(order[next++].t, edge, sample.cell);

      ctx.clearRect(0, 0, s.width, s.height);
      ctx.fillStyle = inkColor();
      particles = particles.filter(p => (p.age += dt) < p.life);
      for (const p of particles) {
        p.x += p.vx * dt; p.y += p.vy * dt; p.vx *= 0.97;
        ctx.globalAlpha = 1 - p.age / p.life;
        ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
      }
      ctx.globalAlpha = 1;

      if (prog < 1 || particles.length) rafId = requestAnimationFrame(frame);
      else finishIntro(run, FLY);
    };
    rafId = requestAnimationFrame(frame);
  }

  function launch(t, edge, cell) {
    // Leave from an ink square near the crumbling edge.
    const near = cells.filter(c => Math.abs(c.x - edge) < cell * 4);
    const from = (near.length ? near : cells)[Math.floor(Math.random() * (near.length || cells.length))];
    const b = box(t), pad = parseFloat(getComputedStyle(stage).paddingLeft) || 0;
    const dx = from.x - (b.x + pad + b.w / 2), dy = from.y - (b.y + pad + b.h / 2);
    const s0 = Math.max(0.03, (cell * 1.4) / b.w);
    t.el.classList.add('has-landed');
    t.el.animate([{ transform: `translate(${dx}px, ${dy}px) scale(${s0})` }, { transform: 'none' }],
                 { duration: FLY, easing: 'cubic-bezier(0.2, 0.75, 0.25, 1)' });
    t.ink.animate([{ opacity: 1 }, { opacity: 1, offset: 0.12 }, { opacity: 0, offset: 0.5 }, { opacity: 0 }], { duration: FLY, fill: 'forwards' });
  }

  function finishIntro(run, after) {
    setTimeout(() => {
      if (run !== introRun) return;
      intro.classList.add('is-gone');
      document.body.classList.add('og-intro-done');
      flyers.forEach(t => t.el.classList.add('has-landed'));
      all.filter(t => !flyers.includes(t)).forEach(t => { t.el.classList.add('is-waiting'); io.observe(t.el); });
      grid.classList.remove('is-intro');
      ctx.clearRect(0, 0, dust.width, dust.height);
      state = 'idle';
      startTease();
      // Load the big pictures now that the opening is done.
      PROJECTS.forEach(p => { new Image().src = p.img; });
    }, after);
  }

  function skipIntro() {
    if (state !== 'intro') return;
    const run = ++introRun;
    cancelAnimationFrame(rafId);
    particles = [];
    logo.style.clipPath = 'inset(0 0 0 100%)';
    flyers.forEach(t => { t.el.classList.add('has-landed'); t.el.getAnimations().forEach(a => a.finish()); t.ink.getAnimations().forEach(a => a.finish()); });
    finishIntro(run, 0);
  }

  const wait = ms => new Promise(r => setTimeout(r, ms));

  // ---------- idle tease: a few squares at a time show their names ----------
  // Up to TEASE_AT_ONCE names are up together. Each starts at its own moment and
  // never on a square touching another one that's showing (sides or corners).
  let teaseTimer = 0, teasing = [], recent = [], teaseColor = 0;
  const DIRS = [[0, 1], [0, -1], [1, 0], [-1, 0]];

  function startTease() { stopTease(); teaseTimer = setTimeout(teaseTick, 900); }
  function stopTease() {
    clearTimeout(teaseTimer);
    teasing.forEach(x => { clearTimeout(x.timer); x.t.el.classList.remove('is-flipped'); });
    teasing = [];
  }
  const touches = (a, b) => Math.abs(a.r - b.r) <= 1 && Math.abs(a.c - b.c) <= 1;
  function teaseTick() {
    if (state === 'idle' && !hovering && !document.hidden && teasing.length < TEASE_AT_ONCE) {
      const pool = tiles.filter(t => !recent.includes(t.i) && t.el.classList.contains('has-landed') && !t.el.classList.contains('is-dimmed') && onScreen(t)
                                  && !teasing.some(x => touches(x.t, t)));
      const t = pool[Math.floor(Math.random() * pool.length)];
      if (t) {
        recent.push(t.i); if (recent.length > 10) recent.shift();
        const [ax, ay] = DIRS[Math.floor(Math.random() * DIRS.length)];
        t.el.style.setProperty('--ax', ax); t.el.style.setProperty('--ay', ay); t.el.style.setProperty('--delay', '0ms');
        t.back.className = 'face back tease-' + (teaseColor++ % 5 + 1);
        t.back.style.backgroundImage = 'none';
        t.el.classList.add('is-flipped');
        const entry = { t };
        entry.timer = setTimeout(() => {
          t.el.classList.remove('is-flipped');
          teasing = teasing.filter(x => x !== entry);
        }, TEASE_HOLD + Math.random() * TEASE_HOLD_JITTER);
        teasing.push(entry);
      }
    }
    teaseTimer = setTimeout(teaseTick, TEASE_EVERY + Math.random() * TEASE_EVERY_JITTER);
  }

  // ---------- reveal: the whole grid turns over to one picture ----------
  let shown = null, origin = null, win = [], revealScroll = 0, captionTimer = 0, cleanTimer = 0;

  // The rows you can see right now, plus the clicked square's row.
  function visibleRows(t) {
    const rows = all.filter(onScreen).map(x => x.r).concat(t.r);
    const r0 = Math.min(...rows), r1 = Math.max(...rows);
    return all.filter(x => x.r >= r0 && x.r <= r1);
  }

  function setRipple(from, set) {
    let far = 0;
    for (const t of set) {
      const dr = t.r - from.r, dc = t.c - from.c, d = Math.hypot(dr, dc);
      far = Math.max(far, d);
      const sideways = Math.abs(dc) >= Math.abs(dr);
      t.el.style.setProperty('--ax', sideways ? 0 : (dr >= 0 ? -1 : 1));
      t.el.style.setProperty('--ay', sideways ? (dc >= 0 ? 1 : -1) : 0);
      t.el.style.setProperty('--delay', reduceMotion.matches ? '0ms' : `${Math.round(d * STEP_MS)}ms`);
    }
    return far * STEP_MS;
  }

  function reveal(t) {
    if (state === 'intro') { skipIntro(); return; }
    if (shown) return;
    stopTease();
    clearTimeout(cleanTimer);
    shown = t.p; origin = t; state = 'revealed';
    win = visibleRows(t);
    revealScroll = scrollY;
    const area = areaOf(win);
    for (const x of win) { x.back.className = 'face back is-slice'; paint(x.back, t.p, area, box(x)); }
    const longest = setRipple(t, win);
    const set = win;
    requestAnimationFrame(() => requestAnimationFrame(() => {
      if (win !== set) return;
      grid.classList.add('is-revealed');
      set.forEach(x => x.el.classList.add('in-reveal'));
    }));
    // Pin the caption to the top of the picture, or the top of the window if the picture runs above it.
    const seenTop = Math.max(area.y, -grid.getBoundingClientRect().top);
    caption.style.top = `calc(${seenTop}px + var(--og-space-3))`;
    captionTitle.textContent = t.p.title;
    caption.href = SITE + t.p.slug;
    clearTimeout(captionTimer);
    captionTimer = setTimeout(() => caption.classList.add('is-on'), reduceMotion.matches ? 0 : longest + 300);
  }

  function hide(quick) {
    if (!shown) return;
    clearTimeout(captionTimer);
    caption.classList.remove('is-on');
    let longest = 0;
    if (quick) win.forEach(t => t.el.style.setProperty('--delay', '0ms'));
    else longest = setRipple(origin, win);
    grid.classList.remove('is-revealed');
    win.forEach(t => t.el.classList.remove('in-reveal'));
    win = [];
    shown = null;
    state = 'idle';
    cleanTimer = setTimeout(() => { if (!hovering) startTease(); }, longest + 600);
  }

  // ---------- input ----------
  // Only real projects open; the color fillers just sit there.
  const tileFor = el => { const a = el.closest('.tile:not(.is-dimmed)'); return a && tiles.find(t => t.el === a); };
  stage.addEventListener('pointerenter', e => {
    if (e.pointerType !== 'mouse') return;
    hovering = true;
    teasing.forEach(x => { clearTimeout(x.timer); x.t.el.classList.remove('is-flipped'); }); teasing = [];
  });
  stage.addEventListener('pointerleave', e => {
    if (e.pointerType !== 'mouse') return;
    hovering = false;
    if (shown) hide(false);
  });

  stage.addEventListener('click', e => {
    if (e.target.closest('.caption')) return;            // the caption is a real link
    e.preventDefault();
    if (state === 'intro') { skipIntro(); return; }
    if (shown) { location.href = SITE + shown.slug; return; }
    const t = tileFor(e.target);
    if (t && t.el.classList.contains('has-landed')) reveal(t);
  });
  addEventListener('scroll', () => {
    if (shown && Math.abs(scrollY - revealScroll) > CLOSE_SCROLL) hide(false);
  }, { passive: true });
  document.addEventListener('pointerdown', e => {
    if (e.pointerType !== 'mouse' && shown && !stage.contains(e.target)) hide(false);
  });

  // Keyboard: Tab to a square, Enter shows it, Enter again opens the project.
  grid.addEventListener('focusin', e => {
    const t = tileFor(e.target);
    if (shown && t !== origin) hide(true);
  });
  stage.addEventListener('keydown', e => {
    if (e.key === 'Enter') {
      e.preventDefault();
      if (shown) { location.href = SITE + shown.slug; return; }
      const t = tileFor(e.target);
      if (t) reveal(t);
    }
    if (e.key === 'Escape') hide(false);
  });
  stage.addEventListener('focusout', e => { if (!stage.contains(e.relatedTarget)) hide(false); });

  // ---------- filter by kind of work ----------
  // The category buttons (in the side menu, and above the grid on phones) dim
  // every square that isn't that kind of work. The grid keeps its shape.
  const filterButtons = [...document.querySelectorAll('[data-filter]')];
  function setFilter(cat) {
    hide(true);
    stopTease();
    filterButtons.forEach(b => {
      const on = b.dataset.filter === cat;
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    tiles.forEach(t => {
      const dim = cat !== 'All' && !t.p.cats.includes(cat);
      t.el.classList.toggle('is-dimmed', dim);
      t.el.tabIndex = dim ? -1 : 0;
    });
    fillers.forEach(f => f.el.classList.toggle('is-dimmed', cat !== 'All'));
    if (state === 'idle') startTease();
  }
  filterButtons.forEach(b => b.addEventListener('click', e => {
    e.stopPropagation();
    if (state === 'intro') skipIntro();
    setFilter(b.dataset.filter || 'All');
  }));

  document.getElementById('og-replay').addEventListener('click', playIntro);

  new ResizeObserver(() => {
    const before = COLS;
    layout();
    if (COLS !== before) { hide(true); return; }
    if (shown) { const area = areaOf(win); win.forEach(x => paint(x.back, shown, area, box(x))); }
  }).observe(grid);

  // Start once the logo and the squares are ready to show.
  Promise.all(PROJECTS.map(p => new Promise(ok => { const i = new Image(); i.onload = i.onerror = ok; i.src = `${ART}tile-${p.slug}.webp`; })))
    .then(playIntro);
})();
</script>
