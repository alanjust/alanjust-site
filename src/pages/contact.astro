---
import BaseLayout from '../layouts/BaseLayout.astro';
import SideNav from '../components/SideNav.astro';
---

<BaseLayout
  title="Contact | Alan Just"
  description="Email Alan Just, graphic designer and illustrator, at alan@alanjust.com."
  currentPath="/contact"
>
  <section class="section">
    <div class="section-with-left-menu">

      <SideNav currentPath="/contact" />

      <div class="div-right-side">
        <div class="services-page">
          <h1 class="heading-2 services-title">Contact</h1>

          <p class="main-text">Email is the best way to reach me: <a href="mailto:alan@alanjust.com" class="cta-link">alan@alanjust.com</a></p>

          <p class="main-text">If it's about a project, tell me what you're making, when you need it and what it has to do. If you're curious what I take on, it's all on the <a href="/design-services" class="cta-link">Design Services</a> page.</p>
        </div>
      </div><!-- /.div-right-side -->
    </div><!-- /.section-with-left-menu -->
  </section>
</BaseLayout>
